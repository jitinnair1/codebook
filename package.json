{
  "name": "sowar",
  "version": "0.1.0",
  "description": "in-browser OCaml exercises",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "check": "tsgo --noEmit",
    "build:ocaml-minify": "terser dist/sowar_toplevel.bc.js -o dist/sowar_toplevel.bc.js --compress --mangle",
    "build": "npm run clean && npm run check && vite build && npm run build:ocaml-minify",
    "dev": "vite",
    "serve": "node server.mjs"
  },
  "dependencies": {
    "@catppuccin/codemirror": "^1.0.3",
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.0",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "codemirror": "^6.0.2",
    "marked": "^17.0.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "@typescript/native-preview": "^7.0.0-dev.20260216.1",
    "tailwindcss": "^4.1.18",
    "terser": "^5.49.0",
    "toml": "^5.0.0",
    "vite": "^8.1.5"
  }
}
